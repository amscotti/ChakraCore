<!-- W3 probe (doc/wasm-arm64-plan.md): validate/compile/instantiate,
     memory/table/global readback, and a real export-call value.
     W2 threw RuntimeError WASMERR_ExecutionNotSupported; W3 executes
     via the ARM64 interpreter, so the call returns 42 (f calls the
     env.inc import with 41). Runs on all arches. -->
<test>
  <default>
    <files>arm64_w2.js</files>
    <baseline>arm64_w2.baseline</baseline>
    <compile-flags>-wasm</compile-flags>
  </default>
</test>
<!-- W6 GC churn probe (doc/wasm-arm64-plan.md W6.4): looped
     instantiate/call/memory.grow/export-read over an MVP wasm module plus
     a verifiable JS object graph under -CollectGarbage. require_backend
     keeps it out of the disable_jit gate counts; -CollectGarbage enables
     the CollectGarbage() builtin the probe asserts on. -->
<test>
  <default>
    <files>gc_churn.js</files>
    <baseline>gc_churn.baseline</baseline>
    <compile-flags>-wasm -CollectGarbage</compile-flags>
    <tags>require_backend</tags>
  </default>
</test>
<!-- W6 pointer-lookalike probe (doc/wasm-arm64-plan.md W6 DoD): wasm
     exports hold a pointer-shaped i32 and an f64 NaN across an import
     that forces a full collection; asserts no crash, WeakRef clearance
     after GC, and uncorrupted returns. Same flag/tag rationale as
     gc_churn above. Exact-address limitation stated in the probe. -->
<test>
  <default>
    <files>gc_lookalike.js</files>
    <baseline>gc_lookalike.baseline</baseline>
    <compile-flags>-wasm -CollectGarbage</compile-flags>
    <tags>require_backend</tags>
  </default>
</test>
<!-- W4 DoD negative test (doc/wasm-arm64-plan.md W4 DoD): wasm atomics must
     be rejected at compile/validate time with threads OFF, in interpreter
     (-nonative) and FullJIT (-ForceNative -off:simpleJit) tiers. Folder tags
     already carry require_backend/require_wasm; the per-entry require_backend
     documents that this suite stays out of the disable_jit gate counts (same
     rationale as the W6 probes above). -->
<test>
  <default>
    <files>atomics_threads_off.js</files>
    <compile-flags>-nonative -WasmThreads- -ESSharedArrayBuffer-</compile-flags>
    <tags>require_backend</tags>
  </default>
</test>
<test>
  <default>
    <files>atomics_threads_off.js</files>
    <compile-flags>-ForceNative -off:simpleJit -WasmThreads- -ESSharedArrayBuffer-</compile-flags>
    <tags>require_backend</tags>
  </default>
</test>
<!-- W7 multi-value probe (ABI Q4): a (func (result i32 i32)) export called
     from JS returns Array [1,2]. Same rationale as the W6 probes above. -->
<test>
  <default>
    <files>multivalue_return.js</files>
    <baseline>multivalue_return.baseline</baseline>
    <compile-flags>-wasm -WasmMultiValue</compile-flags>
    <tags>require_backend</tags>
  </default>
</test>
